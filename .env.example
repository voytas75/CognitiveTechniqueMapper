# Example environment configuration for Cognitive Technique Mapper.
# Copy to .env and replace placeholders with real values.

# Default config.example/ provider: OpenAI.
OPENAI_API_KEY="<your-openai-api-key>"

# Optional Azure OpenAI provider. Set these after switching local config/models.yaml
# to provider: azure_openai and choosing deployments available in your Azure account.
AZURE_API_BASE="https://<your-endpoint>.openai.azure.com"
AZURE_OPENAI_KEY="<your-azure-openai-key>"

# Remember to keep the real .env file out of version control.
